{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/client-repo-template/platform-config.schema.json",
  "title": "Client Repository CI/CD Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["application", "quality", "source_security", "ci", "release", "deploy"],
  "properties": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "runtime": { "type": "string", "enum": ["python", "node", "java", "go", "container"], "default": "python" },
        "owner": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_versions", "commands"],
      "properties": {
        "runtime_versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "type": "string" },
            "node": { "type": "string" },
            "java": { "type": "string" },
            "go": { "type": "string" }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "$ref": "#/$defs/qualityCommands" },
            "node": { "$ref": "#/$defs/qualityCommands" },
            "java": { "$ref": "#/$defs/qualityCommands" },
            "go": { "$ref": "#/$defs/qualityCommands" },
            "container": { "$ref": "#/$defs/qualityCommands" }
          }
        }
      }
    },
    "source_security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_scan", "dependency_scan"],
      "properties": {
        "secret_scan": { "$ref": "#/$defs/mandatorySecurityToggle" },
        "dependency_scan": { "$ref": "#/$defs/securityScan" }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_build_check"],
      "properties": {
        "container_build_check": { "$ref": "#/$defs/optionalFeature" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "aws", "image_security"],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "default": "main",
          "description": "The release branch. Must match the literal in release.yaml on.push.branches."
        },
        "deployment_metadata_retention_days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 1 },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository"],
          "properties": {
            "registry": { "type": "string", "enum": ["ecr"] },
            "repository": { "type": "string", "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$" },
            "dockerfile": { "type": "string", "minLength": 1, "default": "Dockerfile" },
            "context": { "type": "string", "minLength": 1, "default": "." },
            "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" }, "default": ["linux/amd64"] },
            "build_args": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id", "region", "oidc_role_arn"],
          "properties": {
            "account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
            "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
            "oidc_role_arn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$" }
          }
        },
        "image_security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_scan", "sbom", "provenance"],
          "properties": {
            "container_scan": { "$ref": "#/$defs/mandatorySecurityScan" },
            "sbom": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "retention_days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 7 }
              }
            },
            "provenance": { "$ref": "#/$defs/securityToggle" }
          }
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "automatic_environment": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
          "additionalProperties": { "$ref": "#/$defs/deploymentEnvironment" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["automatic_environment", "environments"] }
        }
      ]
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code_scanning": { "$ref": "#/$defs/optionalFeature" },
            "artifact_attestation": { "$ref": "#/$defs/optionalFeature" },
            "deployment_environments": { "$ref": "#/$defs/optionalFeature" }
          }
        }
      }
    },
    "cost_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker_build_records": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "retention_days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 1 }
          }
        },
        "trivy_cache": { "$ref": "#/$defs/optionalFeatureEnabledByDefault" }
      }
    }
  },
  "$defs": {
    "deploymentEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_environment", "aws", "eks", "helm"],
      "properties": {
        "github_environment": { "type": "string", "minLength": 1 },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "oidc_role_arn"],
          "properties": {
            "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
            "oidc_role_arn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$" }
          }
        },
        "eks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cluster_name"],
          "properties": {
            "cluster_name": { "type": "string", "minLength": 1 }
          }
        },
        "helm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_name", "namespace", "chart", "values"],
          "properties": {
            "release_name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "chart": { "type": "string", "minLength": 1 },
            "values": {
              "type": "array",
              "minItems": 0,
              "items": { "type": "string", "minLength": 1 },
              "description": "Helm values files. Empty list is valid when using set_values only."
            },
            "set_values": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
            "container_name": {
              "type": "string",
              "default": "",
              "description": "Name of the application container in the Pod spec. Empty targets the first container. Set explicitly when sidecars are present."
            },
            "create_namespace": {
              "type": "boolean",
              "default": true,
              "description": "Pass --create-namespace to helm upgrade. Set to false when the namespace must be pre-provisioned."
            },
            "history_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Maximum Helm release revisions to retain (--history-max). Prevents etcd growth."
            },
            "timeout": {
              "type": "string",
              "pattern": "^([1-9][0-9]*[smh])+$",
              "default": "10m",
              "description": "Helm wait timeout. Supports compound durations: 10m, 10m30s, 1h30m."
            },
            "atomic": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "qualityCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "lint", "test"],
      "properties": {
        "install": { "type": "string", "minLength": 1 },
        "lint": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 }
      }
    },
    "securityToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "fail_on_findings": { "type": "boolean", "default": true }
      }
    },
    "optionalFeature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "optionalFeatureEnabledByDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "securityScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fail_on_findings"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "fail_on_findings": { "type": "boolean", "default": true },
        "severity": { "type": "string", "default": "CRITICAL,HIGH" }
      }
    },
    "mandatorySecurityToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fail_on_findings"],
      "description": "Secret scanning is mandatory. Neither enabled nor fail_on_findings can be disabled.",
      "properties": {
        "enabled": { "const": true },
        "fail_on_findings": { "const": true }
      }
    },
    "mandatorySecurityScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fail_on_findings"],
      "description": "Container scanning is mandatory. Severity threshold is configurable.",
      "properties": {
        "enabled": { "const": true },
        "fail_on_findings": { "const": true },
        "severity": { "type": "string", "minLength": 1, "default": "CRITICAL,HIGH" }
      }
    }
  }
}
